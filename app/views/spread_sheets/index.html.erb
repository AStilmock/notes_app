<% content_for :title, "SPREADSHEETS" %>

<div class="p-4 sm:p-6 crt-glow font-sheet">
  <div class="flex items-center justify-between border-b border-phosphor-dim pb-3 mb-8">
    <h1 class="text-2xl tracking-widest text-phosphor-bright cursor-block">&gt; SPREADSHEETS</h1>
    <%= button_to "NEW", spread_sheets_path, class: "btn-dos text-base" %>
  </div>

  <section class="panel-dos px-3 pt-6 pb-3 sm:px-4">
    <h2 class="panel-dos-title text-base">DIR C:\SHEETS</h2>
    <div id="spread_sheets_list" class="grid gap-2">
      <% if @spread_sheets.empty? %>
        <p class="text-phosphor-dim">// no entries found</p>
      <% else %>
        <%= render @spread_sheets %>
      <% end %>
    </div>
  </section>
</div>
