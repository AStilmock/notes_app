<% content_for :title, @spread_sheet.title.presence || "UNTITLED" %>

<div class="p-4 sm:p-6 crt-glow font-sheet"
     data-controller="spread-sheet"
     data-spread-sheet-url-value="<%= spread_sheet_path(@spread_sheet) %>"
     data-spread-sheet-cells-value="<%= @spread_sheet.cells.to_json %>"
     data-spread-sheet-col-widths-value="<%= @spread_sheet.col_widths.to_json %>"
     data-spread-sheet-row-heights-value="<%= @spread_sheet.row_heights.to_json %>"
     data-spread-sheet-formats-value="<%= @spread_sheet.formats.to_json %>"
     data-spread-sheet-width-range-value="<%= [SpreadSheet::COL_WIDTHS.min, SpreadSheet::COL_WIDTHS.max].to_json %>"
     data-spread-sheet-height-range-value="<%= [SpreadSheet::ROW_HEIGHTS.min, SpreadSheet::ROW_HEIGHTS.max].to_json %>"
     data-spread-sheet-max-rows-value="<%= SpreadSheet::MAX_ROWS %>"
     data-spread-sheet-max-cols-value="<%= SpreadSheet::MAX_COLS %>"
     data-spread-sheet-max-cell-length-value="<%= SpreadSheet::MAX_CELL_LENGTH %>">

  <div class="flex items-center justify-between mb-6">
    <%= link_to "◄ BACK", spread_sheets_path, class: "text-ink-dim hover:text-ink-bright" %>
    <span data-spread-sheet-target="status" class="text-sm text-ink-dim uppercase tracking-widest"></span>
  </div>

  <div class="panel-dos">
    <input type="text"
           data-spread-sheet-target="title"
           data-action="input->spread-sheet#scheduleSave"
           value="<%= @spread_sheet.title %>"
           placeholder="UNTITLED"
           aria-label="Title"
           class="w-full bg-transparent text-ink-bright text-3xl tracking-wide
                  px-4 py-4 border-b-2 border-phosphor-dim focus:outline-none focus:border-phosphor
                  placeholder-ink-muted" />

    <%# gray keys: grid shape, then formatting for the selected cells (whole cells: a cell is one line of text).
        mousedown->keepFocus leaves focus (and the selection) in the grid. %>
    <div role="toolbar" aria-label="Sheet" class="flex flex-wrap items-center gap-1 px-4 py-3 border-b border-phosphor-faint font-mono">
      <% [
        { label: "+ ROW", action: "addRow", title: "Add a row at the bottom" },
        { label: "+ COL", action: "addColumn", title: "Add a column at the right" },
        { label: "− ROW", action: "removeRow", title: "Remove the selected rows", alert: true },
        { label: "− COL", action: "removeColumn", title: "Remove the selected columns", alert: true },
        { label: "FIT", action: "fitAllColumns", title: "Widen or narrow every column to fit its longest text" }
      ].each do |key| %>
        <button type="button" class="btn-key <%= "btn-key-alert" if key[:alert] %> h-8 px-2 text-base tracking-widest"
                data-action="mousedown->spread-sheet#keepFocus click->spread-sheet#<%= key[:action] %>"
                title="<%= key[:title] %>"><%= key[:label] %></button>
      <% end %>

      <span class="w-px h-6 mx-2 bg-phosphor-dim" aria-hidden="true"></span>

      <% [
        { flag: "b", glyph: "B", label: "Bold (Ctrl/⌘+B)", style: "font-bold" },
        { flag: "i", glyph: "I", label: "Italic (Ctrl/⌘+I)", style: "italic" },
        { flag: "u", glyph: "U", label: "Underline (Ctrl/⌘+U)", style: "underline underline-offset-2" },
        { flag: "s", glyph: "S", label: "Strikethrough (Ctrl/⌘+Shift+X)", style: "line-through" }
      ].each do |key| %>
        <button type="button" class="btn-key size-8 text-xl"
                data-spread-sheet-target="formatButton"
                data-spread-sheet-flag-param="<%= key[:flag] %>"
                data-action="mousedown->spread-sheet#keepFocus click->spread-sheet#format"
                title="<%= key[:label] %>" aria-label="<%= key[:label] %>" aria-pressed="false">
          <span class="<%= key[:style] %>" aria-hidden="true"><%= key[:glyph] %></span>
        </button>
      <% end %>

      <span class="w-px h-6 mx-2 bg-phosphor-dim" aria-hidden="true"></span>

      <%# alignment: icons of text lines lined up left / centered / right %>
      <% [
        { align: "l", label: "Align left", lines: [ [ 2, 14 ], [ 2, 10 ], [ 2, 14 ], [ 2, 8 ] ] },
        { align: "c", label: "Align center", lines: [ [ 1, 15 ], [ 4, 12 ], [ 1, 15 ], [ 5, 11 ] ] },
        { align: "r", label: "Align right", lines: [ [ 2, 14 ], [ 6, 14 ], [ 2, 14 ], [ 8, 14 ] ] }
      ].each do |key| %>
        <button type="button" class="btn-key size-8"
                data-spread-sheet-target="formatButton"
                data-spread-sheet-align-param="<%= key[:align] %>"
                data-action="mousedown->spread-sheet#keepFocus click->spread-sheet#align"
                title="<%= key[:label] %>" aria-label="<%= key[:label] %>" aria-pressed="false">
          <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="square">
            <% key[:lines].each_with_index do |(x1, x2), i| %>
              <line x1="<%= x1 %>" x2="<%= x2 %>" y1="<%= 2 + i * 4 %>" y2="<%= 2 + i * 4 %>" />
            <% end %>
          </svg>
        </button>
      <% end %>

      <button type="button" class="btn-key h-8 px-2 text-base tracking-widest"
              data-action="mousedown->spread-sheet#keepFocus click->spread-sheet#clearFormat"
              title="Clear formatting and alignment">CLEAR</button>

      <span class="ml-auto hidden xl:inline text-sm text-ink-dim font-sheet">
        SHIFT or drag to select · CTRL+C / V copy &amp; paste · drag a header edge to resize
      </span>
    </div>

    <%# the grid is drawn by spread_sheet_controller.js from the cells value %>
    <div class="overflow-x-auto p-4">
      <table data-spread-sheet-target="grid" class="sheet-grid"></table>
    </div>
  </div>
</div>
