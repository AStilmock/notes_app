<% content_for :title, "NOTEPADS" %>

<div class="min-h-screen p-6 crt-glow">
  <div class="flex items-center justify-between border-b border-green-500 pb-3 mb-6">
    <h1 class="text-2xl tracking-widest">&gt; NOTEPADS<span class="animate-pulse">_</span></h1>
    <%= button_to "+ NEW", note_pads_path,
        class: "border border-green-500 px-3 py-1 cursor-pointer hover:bg-green-500 hover:text-black transition" %>
  </div>

  <div id="note_pads_list" class="grid gap-3">
    <% if @note_pads.empty? %>
      <p class="text-green-600 italic">// no entries found</p>
    <% else %>
      <%= render @note_pads %>
    <% end %>
  </div>
</div>
