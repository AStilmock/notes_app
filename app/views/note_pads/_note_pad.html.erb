<%= tag.div id: dom_id(note_pad),
    class: "group flex items-center justify-between gap-3 border border-transparent px-3 py-2
            hover:border-phosphor-dim focus-within:border-phosphor-dim transition" do %>
  <%= link_to note_pad_path(note_pad), class: "flex-1 min-w-0 focus-visible:outline-none" do %>
    <div class="text-xl text-phosphor-bright truncate">
      <span class="text-phosphor-dim group-hover:text-phosphor">►</span>
      <%= note_pad.title.presence || "UNTITLED" %>
    </div>
    <div class="text-sm text-phosphor-dim pl-5">
      updated <%= time_ago_in_words(note_pad.updated_at) %> ago
    </div>
  <% end %>

  <%= button_to note_pad_path(note_pad), method: :delete,
      form: { data: { turbo_confirm: "Delete this pad?" } },
      class: "btn-dos btn-dos-alert text-sm", "aria-label": "Delete #{note_pad.title}" do %>
    DEL
  <% end %>
<% end %>
