<% content_for :title, @note_pad.title.presence || "UNTITLED" %>

<div class="p-4 sm:p-6 crt-glow"
     data-controller="note-pad"
     data-note-pad-url-value="<%= note_pad_path(@note_pad) %>">

  <div class="flex items-center justify-between mb-6">
    <%= link_to "◄ BACK", note_pads_path, class: "text-phosphor-dim hover:text-phosphor-bright" %>
    <span data-note-pad-target="status" class="text-sm text-phosphor-dim uppercase tracking-widest"></span>
  </div>

  <div class="panel-dos">
    <input type="text"
           data-note-pad-target="title"
           data-action="input->note-pad#scheduleSave"
           value="<%= @note_pad.title %>"
           placeholder="UNTITLED"
           aria-label="Title"
           autofocus
           class="w-full bg-transparent text-phosphor-bright text-4xl tracking-wide
                  px-4 py-4 border-b-2 border-phosphor-dim focus:outline-none focus:border-phosphor
                  placeholder-phosphor-muted" />

    <textarea data-note-pad-target="body"
              data-action="input->note-pad#scheduleSave"
              placeholder="type here..."
              aria-label="Body"
              class="ruled-lines w-full bg-transparent text-phosphor text-xl px-4 py-1 min-h-[70vh]
                     focus:outline-none placeholder-phosphor-muted resize-none"
    ><%= @note_pad.body %></textarea>
  </div>
</div>
