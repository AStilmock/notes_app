<%# opened by lib/confirm.js for every data-turbo-confirm %>
<dialog id="confirm_dialog" class="dialog-dos crt-glow w-[min(28rem,calc(100vw-2rem))] p-0">
  <form method="dialog" class="p-6">
    <p class="text-ink-dim text-sm tracking-widest mb-3">▌ CONFIRM</p>
    <p data-confirm-message class="text-xl text-ink-bright mb-6"></p>
    <div class="flex justify-end gap-3">
      <button value="no" class="btn-dos" autofocus><u>N</u>O</button>
      <button value="yes" class="btn-dos btn-dos-alert"><u>Y</u>ES</button>
    </div>
  </form>
</dialog>
