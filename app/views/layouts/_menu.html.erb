<%# DOS-style menu bar. Each item's data-menu-key / data-menu-alt is its keyboard shortcut (menu_controller.js). %>
<% items = authenticated? ? [
  { label: "NOTES", key: "F1", alt: "n", path: note_pads_path, active: controller_name == "note_pads" },
  { label: "SHEETS", key: "F2", alt: "s", path: spread_sheets_path, active: controller_name == "spread_sheets" }
] : [] %>

<nav data-controller="menu" data-action="keydown@window->menu#shortcut"
     class="crt-sticky-top z-40 border-b border-phosphor-dim bg-screen crt-glow" aria-label="Main">
  <div class="flex items-stretch justify-between">
    <% if items.any? %>
    <button type="button" data-action="menu#toggle" data-menu-target="toggle"
            aria-expanded="false" aria-controls="main_menu"
            class="sm:hidden px-4 min-h-11 text-ink-bright hover:bg-phosphor hover:text-screen">
      ≡ MENU
    </button>

    <ul id="main_menu" data-menu-target="list"
        class="hidden sm:flex absolute sm:static top-full inset-x-0 flex-col sm:flex-row
               bg-screen border-b sm:border-0 border-phosphor-dim">
      <% items.each do |item| %>
        <li>
          <%= link_to item[:path],
                data: { menu_key: item[:key], menu_alt: item[:alt] },
                "aria-current": (item[:active] ? "page" : nil),
                title: "#{item[:key]} or Alt+#{item[:alt].upcase}",
                class: "flex items-center gap-2 px-4 min-h-11 tracking-widest
                        #{item[:active] ? 'bg-phosphor text-screen [text-shadow:none]' : 'text-ink hover:bg-phosphor-faint'}" do %>
            <span class="<%= item[:active] ? 'text-screen' : 'text-ink-dim' %> text-sm"><%= item[:key] %></span>
            <%= item[:label] %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% else %>
      <span class="flex items-center px-4 min-h-11 tracking-widest text-ink-bright">NOTES_APP</span>
    <% end %>

    <div class="flex items-center gap-3 pl-4 text-sm text-ink-dim">
      <% if authenticated? %>
        <span class="hidden md:inline truncate max-w-[24ch]" title="Signed in">USER: <%= Current.user.email_address %></span>
        <%= button_to "LOGOUT", session_path, method: :delete, form_class: "flex",
              form: { data: { controller: "offline-cache", action: "submit->offline-cache#clear" } },
              class: "px-4 min-h-11 tracking-widest text-ink hover:bg-phosphor hover:text-screen cursor-pointer" %>
      <% else %>
        <span class="hidden md:inline pr-4">C:\NOTES_APP&gt;</span>
      <% end %>
    </div>
  </div>
</nav>
